table incautaciones
	lineageTag: 769a0fc1-b71a-a08a-ae4a-7b5a5d7319ac

	/// Sumarios distintos con al menos un ítem incautado registrado
	measure Procedimientos = DISTINCTCOUNT ( incautaciones[ProcedimientoKey] )
		formatString: #,0
		lineageTag: e955b7d9-714f-80b9-43eb-886069573bfc

	measure 'Procedimientos año anterior' = CALCULATE ( [Procedimientos], SAMEPERIODLASTYEAR ( fecha[Fecha] ) )
		formatString: #,0
		lineageTag: 325bc555-111b-b050-d5de-9d79cf60151f

	measure 'Variación interanual' = VAR Anterior = [Procedimientos año anterior] RETURN IF ( NOT ISBLANK ( Anterior ), DIVIDE ( [Procedimientos] - Anterior, Anterior ) )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 326e38c8-c06c-404e-6ac0-166751226531

	measure 'Último año' = MAXX ( incautaciones, RELATED ( fecha[Año] ) )
		formatString: 0
		lineageTag: 83fff3d6-dfd9-9a06-0d77-0743aa3a91f5

	measure 'Procedimientos último año' = VAR a = CALCULATE ( [Último año], ALL ( fecha ) ) RETURN CALCULATE ( [Procedimientos], fecha[Año] = a )
		formatString: #,0
		lineageTag: 4003ad85-a58b-17a5-9e97-1df0145153b7

	measure 'Variación último año' = VAR a = CALCULATE ( [Último año], ALL ( fecha ) ) VAR Actual = CALCULATE ( [Procedimientos], fecha[Año] = a ) VAR Anterior = CALCULATE ( [Procedimientos], fecha[Año] = a - 1 ) RETURN IF ( NOT ISBLANK ( Anterior ), DIVIDE ( Actual - Anterior, Anterior ) )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 10e7b6ca-8cef-423a-e4a5-ce0d046bb0b7

	measure 'Promedio anual' = AVERAGEX ( FILTER ( VALUES ( fecha[Año] ), NOT ISBLANK ( [Procedimientos] ) ), [Procedimientos] )
		formatString: #,0.0
		lineageTag: 5bbec377-1d88-9e95-66bc-4bac6fa7d1e2

	/// Participación de la zona sobre el total visible
	measure '% del total' = DIVIDE ( [Procedimientos], CALCULATE ( [Procedimientos], ALLSELECTED ( ubicacion ) ) )
		formatString: 0.0%
		lineageTag: 8a7c5d8d-0018-3bd4-ae8a-79b901a39b84

	measure 'Zonas con procedimientos' = COUNTROWS ( FILTER ( VALUES ( ubicacion[Partido] ), NOT ISBLANK ( [Procedimientos] ) ) )
		formatString: #,0
		lineageTag: 7c2d32d3-19a5-df82-c26d-ffe24099d736

	/// Partido con más procedimientos (empates separados por /)
	measure 'Zona principal' = VAR t = TOPN ( 1, FILTER ( VALUES ( ubicacion[Partido] ), NOT ISBLANK ( [Procedimientos] ) ), [Procedimientos], DESC ) RETURN CONCATENATEX ( t, ubicacion[Partido], " / " )
		lineageTag: e589966a-b5b1-5c11-cb65-18a42eba1610

	measure Subtítulo = VAR d = CALCULATE ( MAXX ( incautaciones, RELATED ( fecha[Fecha] ) ), ALL ( incautaciones ) ) RETURN "Fuente SIFEDESPRE · último procedimiento: " & FORMAT ( d, "dd/mm/yyyy" )
		lineageTag: 656e1e95-8414-ab06-9395-65dea71e142d

