	column 'Es fin de semana'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: c43ef678-d931-4c30-82b3-fb942d444faa
		summarizeBy: none
		sourceColumn: Es fin de semana

		annotation SummarizationSetBy = Automatic

	partition fecha = m
		mode: import
		source =
				let
				  // Calendario generado: no depende de ninguna base de datos
				  Inicio = #date(2020, 1, 1),
				  Fin = #date(2025, 12, 31),
				  Dias = List.Dates(Inicio, Duration.Days(Fin - Inicio) + 1, #duration(1, 0, 0, 0)),
				  Meses = {"Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"},
				  DiasSemana = {"Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"},
				  Filas = List.Transform(Dias, each
				    let
				      d = _, a = Date.Year(d), m = Date.Month(d), t = Date.QuarterOfYear(d), ds = Date.DayOfWeek(d, Day.Monday) + 1
				    in
				      {a * 10000 + m * 100 + Date.Day(d), d, a, "T" & Text.From(t), t, m, Meses{m - 1},
				       Text.From(a) & "-" & Text.PadStart(Text.From(m), 2, "0"), a * 100 + m, Date.WeekOfYear(d, Day.Monday),
				       Date.Day(d), ds, DiasSemana{ds - 1}, ds >= 6}),
				  Tabla = #table(
				    type table [DateKey = Int64.Type, Fecha = date, #"Año" = Int64.Type, Trimestre = text, #"Trimestre Nro" = Int64.Type,
				      #"Mes Nro" = Int64.Type, Mes = text, #"Año-Mes" = text, #"Año-Mes Nro" = Int64.Type, #"Semana ISO" = Int64.Type,
				      #"Día" = Int64.Type, #"Día semana Nro" = Int64.Type, #"Día semana" = text, #"Es fin de semana" = logical],
				    Filas)
				in
				  Tabla

	annotation PBI_ResultType = Table

